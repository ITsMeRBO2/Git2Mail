# Variables d'environnement pour GitLeak Finder
# Copiez ce fichier en .env.local et remplissez les valeurs

# GitHub Personal Access Token (optionnel mais fortement recommandé)
# Secret token to authenticate with GitHub API (Highly recommended)
# Increases rate limit from 60 to 5,000 requests per hour.
# Create one at: https://github.com/settings/tokens/new?scopes=&description=GitLeak+Finder
# GITHUB_TOKEN=ghp_your_token_here

# Secret token to authenticate with GitLab API (Optional)
# GITLAB_TOKEN=glpat_your_token_here

# ============================================================
# Dashboard Security
# ============================================================
# PIN code for dashboard access (6 digits recommended)
DASH_PIN=6767

# Secret used to sign JWT cookies (must be a random secure string in production)
DASH_SECRET=super_secret_jwt_key_please_change_in_production

# URL de base du site (utilisé pour les meta tags OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel KV (optionnel — pour les statistiques persistantes)
# Configuré automatiquement si vous connectez un KV store depuis le dashboard Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
